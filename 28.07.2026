package main

import (
	"bytes"
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"log"
	"net/http"
	"os"
	"time"

	"your_project/comps"
	"your_project/logger"
	"your_project/model"
	"your_project/pg"
)

// Структура тела запроса (Payload) на создание Inquiry
type CreateInquiryRequest struct {
	Type           string                 `json:"type,omitempty"`
	Subject        string                 `json:"subject,omitempty"`
	AdditionalData map[string]interface{} `json:"additionalData,omitempty"`
}

// Функция для отправки POST-запроса с гарантированным Content-Type: application/json
func sendPostInquiry(url string, jsonPayload []byte, token string) ([]byte, int, error) {
	req, err := http.NewRequest("POST", url, bytes.NewBuffer(jsonPayload))
	if err != nil {
		return nil, 0, fmt.Errorf("failed to create request: %w", err)
	}

	// Заголовки (Критично для исправления ошибки 415)
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Accept", "application/json")
	req.Header.Set("Authorization", "Bearer "+token)

	client := &http.Client{Timeout: 30 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return nil, 0, fmt.Errorf("failed to execute request: %w", err)
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, resp.StatusCode, fmt.Errorf("failed to read response body: %w", err)
	}

	return body, resp.StatusCode, nil
}

// Сохранение сырого ответа в базу данных PostgreSQL
func SaveCreateInquiryRawTarget(body []byte, status int, incidentID string) error {
	q := `INSERT INTO inquiries_json(json_, status, incident_id) VALUES($1, $2, $3);`
	_, err := pg.DB().Exec(q, body, status, incidentID)
	if err != nil {
		logger.Log("ERROR", "SaveCreateInquiryRawTarget", "", fmt.Sprintf("failed to insert raw inquiries POST response JSON: %s", err), nil)
		return fmt.Errorf("failed to insert raw inquiries POST response JSON: %w", err)
	}

	callProceduryQuery := `CALL public.p_prc_inquiries_json();`
	_, err = pg.DB().Exec(callProceduryQuery)
	if err != nil {
		logger.Log("ERROR", "SaveCreateInquiryRawTarget", "", fmt.Sprintf("Failed to execute p_prc_inquiries_json(): %s", err), nil)
		return fmt.Errorf("Failed to execute p_prc_inquiries_json(): %w", err)
	}

	return nil
}

func main() {
	in_id := flag.String("in_id", "", "Incident ID")
	desc := flag.String("desc", "", "Inquiry Description")
	inqType := flag.String("type", "MANUAL", "Inquiry Type")
	flag.Parse()

	log.Printf("in_id: %s", *in_id)

	if len(*in_id) == 0 {
		logger.Log("WARN", "create_inquiry.go", "NULL", "create_inquiry.go > id is null", nil)
		os.Exit(1)
	}

	comps.LoadConfiguration("../config.json")

	// ----------------------------------------------------------------------------------------->
	// 1. Проверка и обновление токена авторизации
	authData, _ := model.AFGetAuthStruct()

	secAfterTokenCreation := int(time.Since(authData.CreatedAt).Seconds())
	if secAfterTokenCreation >= authData.RefreshExpiresIn {
		authData, _, err := model.AFAuth(`create_inquiry token expired`)
		if err != nil {
			logger.Log("ERROR", "create_inquiry.go", "null", fmt.Sprintf("create_inquiry.go > AFAuth fiasco: %s", err), err)
			os.Exit(1)
		}
	}

	model.AFGlobalAuthData = authData

	// ----------------------------------------------------------------------------------------->
	// 2. Формирование структуры JSON для POST запроса
	reqPayload := CreateInquiryRequest{
		Type:    *inqType,
		Subject: "Запрос информации по инциденту",
		AdditionalData: map[string]interface{}{
			"description": *desc,
		},
	}

	jsonPayload, err := json.Marshal(reqPayload)
	if err != nil {
		logger.Log("ERROR", "create_inquiry.go", "", fmt.Sprintf("failed to marshal request payload: %s", err), err)
		os.Exit(1)
	}

	// ----------------------------------------------------------------------------------------->
	// 3. Отправка POST запроса
	targetURL := comps.Config.AF.APIURL + `/external/v1/incidents/` + *in_id + `/inquiries`

	log.Println("Шаг 1: Отправка POST запроса на", targetURL)
	body, status, err := sendPostInquiry(targetURL, jsonPayload, authData.Access)
	if err != nil {
		logger.Log("ERROR", "create_inquiry.go", "null", fmt.Sprintf("create_inquiry.go > sendPostInquiry fiasco: %s", err), err)
		os.Exit(1)
	}

	if status == 401 {
		logger.Log("ERROR", "create_inquiry.go", "null", fmt.Sprintf("create_inquiry.go > status 401 unauthorized: %s", err), err)
		os.Exit(1)
	}

	// ----------------------------------------------------------------------------------------->
	// 4. Обработка ответа и сохранение в PostgreSQL
	if status >= 200 && status < 300 {
		log.Println("Шаг 2: POST запрос успешен (status =", status, "). Начинаем SaveCreateInquiryRawTarget...")

		if len(body) > 0 {
			errRaw := SaveCreateInquiryRawTarget(body, status, *in_id)
			if errRaw != nil {
				logger.Log("ERROR", "create_inquiry.go", "", fmt.Sprintf("SaveCreateInquiryRawTarget fiasco:%s", errRaw), errRaw)
			}
			log.Println("[DEBUG] STEP 2: Successfully saved response to DB!")
		}
	} else {
		logger.Log("ERROR", "create_inquiry.go", "STATUS", fmt.Sprintf("failed to create inquiry, status = %d, response = %s", status, string(body)), nil)
		log.Printf("[ERROR] Status = %d, Response = %s\n", status, string(body))
	}

	log.Println("Work is ended")
	os.Exit(0)
}
